<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_attendance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Name & Styled Section Header (Rendered with Unkempt font and #6366F1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:adjustViewBounds="true"
                android:contentDescription="NSync Attendance" />
        </LinearLayout>

        <!-- Dummy/hidden IDs to maintain backward compatibility -->
        <TextView
            android:id="@+id/tv_attendance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_attendance_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_overall_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_stats_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Restyled Refresh Action Button -->
        <ImageView
            android:id="@+id/btn_refresh_attendance"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_refresh_btn_bg"
            android:contentDescription="Refresh Attendance"
            android:padding="6dp"
            android:src="@drawable/ic_huge_refresh" />
    </LinearLayout>

    <!-- Subjects List View -->
    <ListView
        android:id="@+id/lv_attendance_subjects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="#2C2C2E"
        android:dividerHeight="0.5dp" />

    <!-- Empty view if no data -->
    <TextView
        android:id="@+id/tv_attendance_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Tap to log in and sync NSUT attendance"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
