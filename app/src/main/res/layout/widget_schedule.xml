<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Name & Styled Section Header (Rendered with Unkempt font and #6366F1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:adjustViewBounds="true"
                android:contentDescription="NSync Schedule" />
        </LinearLayout>

        <!-- Hidden backward compatibility views -->
        <TextView
            android:id="@+id/tv_schedule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_schedule_day_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Live/Today Badge -->
        <TextView
            android:id="@+id/tv_schedule_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_accent"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="TODAY"
            android:textColor="#6366F1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Restyled Refresh Action Button -->
        <ImageView
            android:id="@+id/btn_refresh_schedule"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_refresh_btn_bg"
            android:contentDescription="Refresh Schedule"
            android:padding="6dp"
            android:src="@drawable/ic_huge_refresh" />
    </LinearLayout>

    <!-- Up Next / Ongoing Highlight Card (Hidden - state tags rendered on cards) -->
    <LinearLayout
        android:id="@+id/layout_current_class_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Today's Schedule List -->
    <ListView
        android:id="@+id/lv_schedule_classes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="#2C2C2E"
        android:dividerHeight="0.5dp" />

    <!-- Empty view if no classes -->
    <TextView
        android:id="@+id/tv_schedule_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No classes scheduled for today 🌴"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
