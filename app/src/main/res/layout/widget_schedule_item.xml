<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="5dp">

    <!-- Time slot -->
    <TextView
        android:id="@+id/tv_schedule_item_time"
        android:layout_width="74dp"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_accent"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:text="09:00 - 10:00"
        android:textColor="#E2E8F0"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_schedule_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Machine Learning"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_schedule_item_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Block VI - 302 • Dr. Anand Gupta"
            android:textColor="#8F9CAE"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Type Tag -->
    <TextView
        android:id="@+id/tv_schedule_item_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge_safe"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="LEC"
        android:textColor="#2ECC71"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
