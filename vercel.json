{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/download",
      "destination": "/docs/downloads/NSync.apk"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "/docs/downloads/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/docs/assets/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
